@model IEnumerable<CarsApp.Models.Cars.CarIndexViewModel>

@{
    var currentSortOrder = ViewContext.HttpContext.Request.Query["sortOrder"].ToString();
    var currentSearchString = ViewContext.HttpContext.Request.Query["searchString"].ToString();
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int maxPageLinks = 3;
    int startPage = Math.Max(1, currentPage - 1);
    int endPage = Math.Min(totalPages, currentPage + 1);

    if (currentPage == 1)
    {
        endPage = Math.Min(totalPages, startPage + (maxPageLinks - 1));
    }
    else if (currentPage == totalPages)
    {
        startPage = Math.Max(1, endPage - (maxPageLinks - 1));
    }
}

<div class="container">
    <a asp-action="create" asp-controller="Cars" type="submit" class="btn btn-success">Create</a>
</div>

<div class="h1">
    Cars
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-warning">No cars are available to display.</div>
}
else
{
    <div class="table-container">
        <form method="post">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        <th scope="col">Make</th>
                        <th scope="col">
                            Model
                            @if (currentSortOrder == "model_desc")
                            {
                                <a asp-action="Index" asp-route-sortOrder="model_asc" asp-route-searchString="@currentSearchString">▲</a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-sortOrder="model_desc" asp-route-searchString="@currentSearchString">▼</a>
                            }
                        </th>
                        <th scope="col">
                            Color
                            @if (currentSortOrder == "color_desc")
                            {
                                <a asp-action="Index" asp-route-sortOrder="color_asc" asp-route-searchString="@currentSearchString">▲</a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-sortOrder="color_desc" asp-route-searchString="@currentSearchString">▼</a>
                            }
                        </th>
                        <th scope="col">
                            Year
                            @if (currentSortOrder == "year_desc")
                            {
                                <a asp-action="Index" asp-route-sortOrder="year_asc" asp-route-searchString="@currentSearchString">▲</a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-sortOrder="year_desc" asp-route-searchString="@currentSearchString">▼</a>
                            }
                        </th>
                        <th scope="col">
                            Fuel
                            @if (currentSortOrder == "fuel_desc")
                            {
                                <a asp-action="Index" asp-route-sortOrder="fuel_asc" asp-route-searchString="@currentSearchString">▲</a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-sortOrder="fuel_desc" asp-route-searchString="@currentSearchString">▼</a>
                            }
                        </th>
                        <th scope="col">
                            Transmission
                            @if (currentSortOrder == "transmission_desc")
                            {
                                <a asp-action="Index" asp-route-sortOrder="transmission_asc" asp-route-searchString="@currentSearchString">▲</a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-sortOrder="transmission_desc" asp-route-searchString="@currentSearchString">▼</a>
                            }
                        </th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in Model.Select((value, index) => new { Value = value, Index = index + 1 }))
                    {
                        <tr>
                            <td>@car.Index</td>
                            <td>@car.Value.Make</td>                           
                            <td>@car.Value.Model</td>
                            <td>@car.Value.Color</td>
                            <td>@car.Value.Year</td>
                            <td>@car.Value.Fuel</td>
                            <td>@car.Value.Transmission</td>
                            <td>
                                <img src="@car.Value.Picture" alt="@car.Value.Make" style="width:100px; height: auto" />
                            </td>
                            <td>
                                <a asp-action="details" asp-controller="Cars" asp-route-id="@car.Value.Id" class="btn btn-info">Details</a>
                                <a asp-action="update" asp-controller="Cars" asp-route-id="@car.Value.Id" class="btn btn-primary">Update</a>
                                <a asp-action="delete" asp-controller="Cars" asp-route-id="@car.Value.Id" class="btn btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(currentSearchString))
    {
        <form method="get" asp-action="Index">
            <button type="submit" class="btn button-primary">Back to Full List</button>
        </form>

    }

    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" aria-label="Previous" asp-action="Index" asp-route-pageNumber="@(currentPage - 1)" asp-route-sortOrder="@currentSortOrder" asp-route-searchString="@currentSearchString">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-sortOrder="@currentSortOrder" asp-route-searchString="@currentSearchString">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" aria-label="Next" asp-action="Index" asp-route-pageNumber="@(currentPage + 1)" asp-route-sortOrder="@currentSortOrder" asp-route-searchString="@currentSearchString">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
