@model CarsApp.Models.Cars.CarDetailsViewModel

<h1>Details</h1>

<div>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Id)
        </div>

        <div class="form-group row">
            <label asp-for="Make" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Make)
        </div>

        <div class="form-group row">
            <label asp-for="Model" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Model)
        </div>

        <div class="form-group row">
            <label asp-for="Color" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Color)
        </div>

        <div class="form-group row">
            <label asp-for="Year" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Year)
        </div>

        <div class="form-group row">
            <label asp-for="Fuel" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Fuel)
        </div>

        <div class="form-group row">
            <label asp-for="Transmission" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Transmission)
        </div>

        <div class="form-group row">
            <label asp-for="CreatedAt" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.CreatedAt)
        </div>

        <div class="form-group row">
            <label asp-for="ModifiedAt" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.ModifiedAt)
        </div>

        <div class="form-group row">
            <label asp-for="Picture" class="col-sm-2 col-form-label"></label>
            <img src="@Html.DisplayFor(model => model.Picture)" style="width:200px; height: auto" />
        </div>

    </dl>
    <a asp-action="Index" asp-controller="Cars" class="btn btn-danger">Back</a>
</div>
